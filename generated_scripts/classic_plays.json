      "scenes": [
        {
          "scene_id": 1,
          "title": "一借芭蕉扇",
          "description": "孙悟空向铁扇公主借扇，被扇飞",
          "lines": [
            {"speaker": "旁白", "text": "火焰山挡住去路，孙悟空向铁扇公主借扇。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "嫂嫂，借芭蕉扇一用！", "action": "greet", "duration": 2.0},
            {"speaker": "铁扇公主", "text": "你这泼猴，也敢来借扇！", "action": "back", "duration": 2.5},
            {"speaker": "铁扇公主", "text": "看扇！", "action": "dance", "duration": 2.0},
            {"speaker": "孙悟空", "text": "哎呀！被扇飞了！", "action": "jump", "duration": 2.5}
          ]
        },
        {
          "scene_id": 2,
          "title": "二借芭蕉扇",
          "description": "孙悟空变作虫子钻进铁扇公主肚子",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空变作蟭蟟虫，钻入铁扇公主腹中。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "嫂嫂，快把扇子借我！", "action": "dun", "duration": 2.0},
            {"speaker": "铁扇公主", "text": "疼死我了！快出来！", "action": "scratch", "duration": 2.5},
            {"speaker": "铁扇公主", "text": "给你扇子，快走！", "action": "forward", "duration": 2.0}
          ]
        },
        {
          "scene_id": 3,
          "title": "三借芭蕉扇",
          "description": "孙悟空智取真扇，扇灭火焰山",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空拿到假扇，又变作牛魔王骗得真扇。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "这扇子是真是假？试试看！", "action": "dance", "duration": 2.0},
            {"speaker": "牛魔王", "text": "遭了！被骗了！", "action": "back", "duration": 2.5},
            {"speaker": "孙悟空", "text": "火焰山，灭！", "action": "jump", "duration": 2.5}
          ]
        }
      ]
    },
    {
