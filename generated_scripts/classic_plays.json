            {"speaker": "哪吒", "text": "牛魔王，还不投降！", "action": "forward", "duration": 2.5},
            {"speaker": "牛魔王", "text": "罢了，我认输！", "action": "dun", "duration": 2.0},
            {"speaker": "孙悟空", "text": "牛兄，以后莫要与取经人作对。", "action": "greet", "duration": 2.5}
          ]
        }
      ]
    }
  ]
}