            {"speaker": "红孩儿", "text": "救命啊！有妖怪！", "action": "scratch", "duration": 2.5},
            {"speaker": "唐僧", "text": "悟空，快去救他。", "action": "normal", "duration": 2.0},
            {"speaker": "孙悟空", "text": "师父，他可能有诈！", "action": "back", "duration": 2.0}
          ]
        },
        {
          "scene_id": 2,
          "title": "红孩儿掳唐僧",
          "description": "红孩儿趁孙悟空不注意，掳走唐僧",
          "lines": [
            {"speaker": "旁白", "text": "红孩儿突然发难，卷起旋风掳走唐僧。", "action": "idle", "duration": 3.0},
            {"speaker": "红孩儿", "text": "哈哈，唐僧肉归我了！", "action": "jump", "duration": 2.5},
            {"speaker": "孙悟空", "text": "哪里走！", "action": "forward", "duration": 2.0},
            {"speaker": "红孩儿", "text": "三昧真火！", "action": "dance", "duration": 2.5}
          ]
        },
        {
          "scene_id": 3,
          "title": "收服红孩儿",
          "description": "孙悟空请来观音菩萨，收服红孩儿为善财童子",
          "lines": [
            {"speaker": "旁白", "text": "观音菩萨降临，用宝瓶收服红孩儿。", "action": "idle", "duration": 3.0},
            {"speaker": "观音", "text": "红孩儿，还不归顺？", "action": "normal", "duration": 2.5},
            {"speaker": "红孩儿", "text": "菩萨饶命！我愿意皈依！", "action": "dun", "duration": 2.0},
            {"speaker": "孙悟空", "text": "好，这下清静了。", "action": "greet", "duration": 2.0}
          ]
        }
      ]
    },
