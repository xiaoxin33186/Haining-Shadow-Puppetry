{
  "plays": [
    {
      "name": "闹龙宫",
      "title": "闹龙宫",
      "theme": "西游记",
      "scenes": [
        {
          "scene_id": 1,
          "title": "龙宫借宝",
          "description": "孙悟空前往东海龙宫向龙王借兵器",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空来到东海龙宫，金箍棒闪闪发光。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "老龙王，借俺老孙一件趁手兵器！", "action": "greet", "duration": 2.5},
            {"speaker": "龙王", "text": "大圣请随我来，看看这些兵器如何。", "action": "forward", "duration": 2.0},
            {"speaker": "孙悟空", "text": "太轻太轻，都不中用！", "action": "scratch", "duration": 2.5}
          ]
        },
        {
          "scene_id": 2,
          "title": "得宝金箍棒",
          "description": "孙悟空发现定海神针，并将其变为金箍棒",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空看到一根大铁柱，上面写着‘如意金箍棒’。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "好宝贝！变细些！", "action": "dance", "duration": 2.0},
            {"speaker": "龙王", "text": "大圣且慢，那是定海神针！", "action": "back", "duration": 2.5},
            {"speaker": "孙悟空", "text": "哈哈，今儿归俺老孙了！", "action": "jump", "duration": 2.5}
          ]
        },
        {
          "scene_id": 3,
          "title": "龙宫震荡",
          "description": "孙悟空挥舞金箍棒，龙宫摇动",
          "lines": [
            {"speaker": "旁白", "text": "金箍棒挥动，龙宫天翻地覆。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "老龙王，借你宝地练练手！", "action": "dance", "duration": 2.5},
            {"speaker": "龙王", "text": "大圣快住手！我龙宫要塌了！", "action": "dun", "duration": 2.0},
            {"speaker": "孙悟空", "text": "罢了，俺老孙去也！", "action": "forward", "duration": 2.0}
          ]
        }
      ]
    },
    {
      "name": "大闹天宫",
      "title": "大闹天宫",
      "theme": "西游记",
      "scenes": [
        {
          "scene_id": 1,
          "title": "偷桃盗丹",
          "description": "孙悟空偷吃蟠桃，盗取仙丹",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空看守蟠桃园，偷吃仙桃。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "这蟠桃果然美味！", "action": "dance", "duration": 2.0},
            {"speaker": "仙女", "text": "大圣，王母娘娘要开蟠桃会了。", "action": "normal", "duration": 2.5},
            {"speaker": "孙悟空", "text": "蟠桃会？怎么没请俺老孙？", "action": "scratch", "duration": 2.0}
          ]
        },
        {
          "scene_id": 2,
          "title": "大闹蟠桃会",
          "description": "孙悟空搅乱蟠桃会，偷吃仙丹",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空变作赤脚大仙，混入瑶池。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "哈哈哈，仙酒仙果，归我享用！", "action": "jump", "duration": 2.5},
            {"speaker": "天兵", "text": "大胆妖猴！竟敢扰乱盛会！", "action": "forward", "duration": 2.0},
            {"speaker": "孙悟空", "text": "俺老孙来去自如，看棒！", "action": "dance", "duration": 2.5}
          ]
        },
        {
          "scene_id": 3,
          "title": "逃回花果山",
          "description": "孙悟空反出天宫，回到花果山",
          "lines": [
            {"speaker": "旁白", "text": "孙悟空大闹天宫后，返回花果山。", "action": "idle", "duration": 3.0},
            {"speaker": "孙悟空", "text": "孩儿们，俺老孙回来了！", "action": "greet", "duration": 2.5},
            {"speaker": "众猴", "text": "大王威武！大王万岁！", "action": "dance", "duration": 2.0}
          ]
        }
      ]
    },
    {
